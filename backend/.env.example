ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/srm_assistant
# LLM_PROVIDER: openai or groq. EMBEDDING_PROVIDER: openai, or local to run
# fastembed on this machine. For Groq with local embeddings set:
#   LLM_PROVIDER=groq, GROQ_API_KEY, OPENAI_MODEL=openai/gpt-oss-120b,
#   EMBEDDING_PROVIDER=local, EMBEDDING_MODEL=BAAI/bge-small-en-v1.5,
#   EMBEDDING_DIMENSIONS=384
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_CHARACTERS=2000
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
CONVERSATION_HISTORY_LIMIT=8
CONTEXT_CHUNK_LIMIT=5
CONTEXT_SIMILARITY_MARGIN=0.12
ALLOWED_SOURCE_DOMAINS=srmist.edu.in
UPLOAD_MAX_BYTES=10000000
MAX_SOURCE_BYTES=10000000
FETCH_TIMEOUT_SECONDS=20
CONVERSATION_RETENTION_DAYS=30
ENABLE_INGESTION_SCHEDULER=false
INGESTION_INTERVAL_HOURS=24
